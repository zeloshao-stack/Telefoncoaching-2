# --- Stimme ---
# Gratis lokal (ohne API-Rechnung): einmal `npm run tts:setup`, dann ohne Keys nutzen.
# TTS_PROVIDER=local erzwingt nur Piper/macOS say.
# TTS_PREFER_LOCAL=1 bevorzugt lokal auch wenn Cloud-Keys gesetzt sind.
TTS_PROVIDER=
TTS_PREFER_LOCAL=

# Optional — Cloud (Qualität/Latenz, pro Nutzung kostenpflichtig):

# 1) Cartesia Sonic — flüssig + niedrige Latenz
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3

# 2) ElevenLabs — Stimme folgt der inneren Lage (Seufzer, Tempo, Lachen)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# v3 = Gefühl in der Stimme. Fallback intern auf multilingual_v2.
# Latenz: eleven_flash_v2_5 | nur Textklarheit: eleven_multilingual_v2
ELEVENLABS_TTS_MODEL=eleven_v3
# Optional erzwingen: TTS_PROVIDER=elevenlabs

# 3) Azure Neural de-AT (Ingrid/Jonas), Free F0 mit Monats-Kontingent
# Azure Portal → Speech resource → Keys
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# LLM (Rollenspiel / Coach / Whisper-Transkript)
OPENAI_API_KEY=

# Live-Telefonat (OpenAI Realtime, WebRTC). Braucht OPENAI_API_KEY.
# Modell: Default gpt-realtime-2.1 (volles Realtime). Mini bleibt Override:
# REALTIME_MODEL=gpt-realtime-2.1-mini
# gpt-6-astra hat in der API kein Audio — nicht als Live-Modell setzen.
# Lehnt OpenAI das Modell ab, fällt der Server automatisch einmal auf gpt-realtime zurück.
REALTIME_MODEL=
# Sprechpausen-Erkennung: leer = server_vad (Default), "semantic" = semantic_vad (eagerness high)
REALTIME_VAD=
OPENROUTER_API_KEY=
LLM_MODEL=
# Text-Rollenspiel: Default gpt-5 (Chat Completions 2026). Alter Default: LLM_ROLEPLAY_MODEL=gpt-4o
# Stärker/teurer nur Text, kein Live-Audio: LLM_ROLEPLAY_MODEL=gpt-6-astra
LLM_ROLEPLAY_MODEL=
LLM_COACH_MODEL=
